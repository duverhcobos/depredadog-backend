# App
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL + TypeORM) — owner, corre migraciones
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=pcalientes_db
# SSL a la BD — true en producción (Supabase lo exige); false en local
DB_SSL=false

# Rol de aplicación sin privilegios (si el proyecto usa RLS multi-tenant)
# DB_APP_USERNAME=app_role
# DB_APP_PASSWORD=

# Migraciones al arrancar (true solo en dev/test local)
MIGRATIONS_RUN=true

# Esquema vía synchronize — SIEMPRE false, las migraciones mandan (migrations-workflow)
DB_SYNCHRONIZE=false

# CORS — orígenes permitidos separados por coma (sin default '*').
# VACÍO = API solo-móvil (decisión): los clientes nativos no envían Origin,
# así que se deniegan todos los orígenes de navegador. Si a futuro hay panel
# web, declarar el origen explícito, ej: http://localhost:5173
CORS_ORIGIN=

# Throttling global — holgado A PROPÓSITO: los endpoints sensibles (login,
# verificación, reset) tienen su propio @Throttle más estricto (3–10/min).
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logger Winston (archivo rotativo en LOG_DIR)
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# Auth/JWT — JWT_SECRET: generar con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# NUNCA reusar el mismo secret entre entornos (env-secrets)
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# TTL del código de verificación/reset (minutos)
AUTH_CODE_TTL_MINUTES=15

# Google Sign-In — client IDs separados por coma (Android/iOS/web, consola de Google Cloud)
# Se usa en la propuesta 003; vacío = endpoint /auth/google no disponible
GOOGLE_CLIENT_IDS=

# Email (Resend — https://resend.com): API key del dashboard.
# Vacío = el servicio NO envía y loguea el código (fallback dev).
# EMAIL_FROM: remitente verificado en Resend — con dominio sin verificar solo
# sirve 'onboarding@resend.dev' hacia el email de la propia cuenta.
RESEND_API_KEY=
EMAIL_FROM=Depredadog <onboarding@resend.dev>

# Store — timezone del negocio para horario de atención y consecutivo
# de pedidos (IANA). Default: America/Bogota.
# STORE_TIMEZONE=America/Bogota

# Pagos — driver del puerto de pasarela ('sim' dev; 'nequi' con llaves QA)
PAYMENT_GATEWAY_DRIVER=sim
# Secreto compartido del webhook de pagos (header x-webhook-secret)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Usuario dueño (panel admin) — solo DEV: `npm run seed:admin` crea/actualiza
# el usuario con role=admin. En producción se crea una vez a mano.
# ADMIN_EMAIL=admin@depredadog.com
# ADMIN_PASSWORD=
